# cmake/compile_lua_bytecode.cmake
#
# Compiles all Lua modules to LuaJIT bytecode and combines them into a single
# C source file. Each module becomes a dllexport'd byte-array symbol
# (luaJIT_BC_<modname>) that LuaJIT's require() finds automatically via
# GetProcAddress / dlsym at runtime.
#
# Variables (passed via -D from the parent CMakeLists.txt):
#   LUAJIT_EXE      - Path to the luajit executable
#   LUAJIT_JIT_DIR  - Path to LuaJIT source dir (contains jit/ subfolder)
#   WX_SRC_DIR      - Directory containing generated wx/*_gen.lua files
#   LUA_SRC_DIR     - Directory containing manual lua/wx/*.lua files
#   OUT_DIR          - Intermediate build directory for .c fragments
#   COMBINED_OUTPUT  - Path to the final combined .c output file

# LuaJIT's -b command is implemented by jit/bcsave.lua. The freshly built
# luajit.exe won't find it without LUA_PATH pointing to the source tree.
set(ENV{LUA_PATH} "${LUAJIT_JIT_DIR}/?.lua")

file(MAKE_DIRECTORY "${OUT_DIR}/c")

set(C_FILES "")

# ---------------------------------------------------------------------------
# Generated wx/ modules — module name is the filename stem
# ---------------------------------------------------------------------------
file(GLOB WX_LUA_FILES "${WX_SRC_DIR}/*_gen.lua")
list(SORT WX_LUA_FILES)

foreach(LUA_FILE ${WX_LUA_FILES})
    get_filename_component(MOD_NAME "${LUA_FILE}" NAME_WE)
    set(C_FILE "${OUT_DIR}/c/${MOD_NAME}.c")
    execute_process(
        COMMAND "${LUAJIT_EXE}" -b -n "${MOD_NAME}" "${LUA_FILE}" "${C_FILE}"
        RESULT_VARIABLE rc
    )
    if(rc EQUAL 0)
        list(APPEND C_FILES "${C_FILE}")
    else()
        message(WARNING "luajit -b failed for ${LUA_FILE} (module: ${MOD_NAME})")
    endif()
endforeach()

# ---------------------------------------------------------------------------
# Manual lua/wx/ modules — explicit module names for require()
# Format: "module.name|/absolute/path/to/file.lua"
# ---------------------------------------------------------------------------
set(MANUAL_MODULES
    "wx|${LUA_SRC_DIR}/wx/init.lua"
    "wx.events|${LUA_SRC_DIR}/wx/events.lua"
    "wx.app|${LUA_SRC_DIR}/wx/app.lua"
    "wx.debug_agent|${LUA_SRC_DIR}/wx/debug_agent.lua"
)

foreach(ENTRY ${MANUAL_MODULES})
    string(REPLACE "|" ";" PARTS "${ENTRY}")
    list(GET PARTS 0 MOD_NAME)
    list(GET PARTS 1 LUA_FILE)
    string(REPLACE "." "_" C_BASENAME "${MOD_NAME}")
    set(C_FILE "${OUT_DIR}/c/${C_BASENAME}.c")
    execute_process(
        COMMAND "${LUAJIT_EXE}" -b -n "${MOD_NAME}" "${LUA_FILE}" "${C_FILE}"
        RESULT_VARIABLE rc
    )
    if(rc EQUAL 0)
        list(APPEND C_FILES "${C_FILE}")
    else()
        message(WARNING "luajit -b failed for ${LUA_FILE} (module: ${MOD_NAME})")
    endif()
endforeach()

# ---------------------------------------------------------------------------
# Combine all .c fragments into a single translation unit
# ---------------------------------------------------------------------------
# Each luajit -b .c output is a self-contained declaration with
# extern "C" / __declspec(dllexport) guards, so concatenation is valid.

set(COMBINED "/* Auto-generated: embedded LuaJIT bytecode modules */\n")
string(APPEND COMBINED "/* Do NOT edit — regenerated by cmake/compile_lua_bytecode.cmake */\n\n")

foreach(C_FILE ${C_FILES})
    file(READ "${C_FILE}" CONTENT)
    string(APPEND COMBINED "${CONTENT}\n")
endforeach()

# Only write if content changed — preserves the timestamp so the C compiler
# and linker don't rebuild kwxlua needlessly on every build.
set(_needs_write TRUE)
if(EXISTS "${COMBINED_OUTPUT}")
    file(READ "${COMBINED_OUTPUT}" _existing)
    if(_existing STREQUAL "${COMBINED}")
        set(_needs_write FALSE)
    endif()
endif()
if(_needs_write)
    file(WRITE "${COMBINED_OUTPUT}" "${COMBINED}")
endif()

list(LENGTH C_FILES NUM_MODULES)
message(STATUS "Embedded ${NUM_MODULES} Lua bytecode modules → ${COMBINED_OUTPUT}")
